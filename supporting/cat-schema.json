        "onChange": [
            {
                "sys_id": "cb3cc8eb1bbf3910d63e98271d4bcbfe",
                "fieldName": "requested_for",
                "name": "SP Autofil User Details - Change",
                "type": "onChange",
                "script": "function onChange(control, oldValue, newValue, isLoading) {\n   if (isLoading || newValue == '') {\n      return;\n   }\n   var fetchFields = \"email,user_name,manager,location,cost_center\";\n\tvar ga = new GlideAjax('FinanceFdCatalogUtils').setScope(\"x_bskyb_fn\");\n\tga.addParam('sysparm_name', \"getUserRecordFields\");\n\tga.addParam('sysparam_fields', fetchFields);\n\tga.addParam('sysparm_requster', g_form.getValue('requested_for'));\n\tga.getXMLAnswer(function(answer){\n\t\tif(answer != ''){\n\t\t\tvar ansArray = answer.split(',');\n\t\t\tg_form.setValue('email_address', ansArray[0]);\n\t\t\tg_form.setValue('user_id', ansArray[1]);\n\t\t\tg_form.setValue('manager_sponsor', ansArray[2]);\n\t\t\tg_form.setValue('location', ansArray[3]);\n\t\t\tg_form.setValue('cost_code', ansArray[4]);\n\t\t}\n\t});\n   \n}\n",
                "tableName": ""
            }
        ],
        "onSubmit": [],
        "onLoad": [
            {
                "sys_id": "1f3c0ceb1bbf3910d63e98271d4bcb36",
                "fieldName": "7f513ef41b6a71147d55873be54bcb06",
                "name": "SP Autofil User Details at Load",
                "type": "onLoad",
                "script": "function onLoad() {\n\tvar fetchFields = \"email,user_name,manager,location,cost_center\";\n\tvar ga = new GlideAjax('FinanceFdCatalogUtils').setScope(\"x_bskyb_fn\");\n\tga.addParam('sysparm_name', \"getUserRecordFields\");\n\tga.addParam('sysparam_fields', fetchFields);\n\tga.addParam('sysparm_requster', g_form.getValue('requested_for'));\n\tga.getXMLAnswer(function(answer){\n\t\tif(answer != ''){\n\t\t\tvar ansArray = answer.split(',');\n\t\t\tg_form.setValue('email_address', ansArray[0]);\n\t\t\tg_form.setValue('user_id', ansArray[1]);\n\t\t\tg_form.setValue('manager_sponsor', ansArray[2]);\n\t\t\tg_form.setValue('location', ansArray[3]);\n\t\t\tg_form.setValue('cost_code', ansArray[4]);\n\t\t}\n\t});\n}\n",
                "tableName": ""
